generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  audits        Audit[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Audit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  clientName  String
  formData    Json
  results     Json
  createdAt   DateTime @default(now())
}
